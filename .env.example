# ── Google Gemini API Key (Required) ─────────────────────────────────────────
# Get free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL Database URL (Required for Vercel persistence) ─────────────────
# Get free from Supabase (https://supabase.com) or Neon (https://neon.tech)
DATABASE_URL=postgresql://postgres:password@your-db-host:5432/postgres

# ── Cloudinary Image Storage (Required for Vercel image uploads) ───────────────
# Get free from Cloudinary (https://cloudinary.com)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
